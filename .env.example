# PostHog Analytics (optional for local dev; set in Vercel for production)
# Production sends events same-origin through the /ingest proxy in vercel.json,
# so VITE_PUBLIC_POSTHOG_HOST is only the direct ingestion host for local dev.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server Configuration (optional)
# PORT=3000
