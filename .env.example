# PostHog Analytics (optional for local dev; set in Vercel for production)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Source map upload during production `vite build` (set these on Vercel).
# POSTHOG_API_KEY is a personal API key with error tracking write — not the
# phc_ project token. POSTHOG_PROJECT_ID defaults to this project's id.
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=294072
# POSTHOG_HOST=https://us.i.posthog.com

# Server Configuration (optional)
# PORT=3000
